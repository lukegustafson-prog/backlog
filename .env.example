# Copy to .env for local development. For production, set these in your host
# (e.g. Vercel) dashboard — never commit real secrets.

# --- Local development (SQLite file) ---
DATABASE_URL="file:./dev.db"

# --- Password gate ---
# The single shared password that unlocks the site.
SITE_PASSWORD="choose-a-strong-password"
# Secret used to sign the session cookie. Use a long random string in production,
# e.g. `openssl rand -hex 32`.
SESSION_SECRET="a-long-random-string"

# --- Production database (Turso / libSQL) ---
# Leave these UNSET locally. When set, the app uses Turso instead of the SQLite file.
# TURSO_DATABASE_URL="libsql://your-db-name-you.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"
