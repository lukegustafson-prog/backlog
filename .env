# Local development environment (safe to commit — these are LOCAL dev values only).
#
# Local dev uses a SQLite file (no Turso). Production sets TURSO_DATABASE_URL,
# TURSO_AUTH_TOKEN, SITE_PASSWORD and SESSION_SECRET in the host dashboard instead.
DATABASE_URL="file:./dev.db"

# Password gate (dev defaults — CHANGE THESE in production via host env vars).
SITE_PASSWORD="changeme"
SESSION_SECRET="dev-insecure-secret-change-me"
